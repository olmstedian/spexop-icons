# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf

# Documentation
*.md text eol=lf

# SVG files
*.svg text eol=lf

# Configuration
*.yml text eol=lf
*.yaml text eol=lf

# Lockfiles
pnpm-lock.yaml binary


